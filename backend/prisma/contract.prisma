// use prisma-8
model User {
  id            Uuid                                  @id @onCreate(uuid())
  email         String(storage: varchar, length: 255)
  passwordHash  String(storage: varchar, length: 255) @map("password_hash")
  fullName      String(storage: varchar, length: 150) @map("full_name")
  role          String(storage: varchar, length: 30)  @default("admin")
  isActive      Boolean                               @default(true) @map("is_active")
  createdAt     DateTime                              @default(now()) @map("created_at")
  updatedAt     DateTime                              @onCreate(now()) @onUpdate(now()) @map("updated_at")
  refreshTokens RefreshToken[]

  @@index(expression: sql`lower(email)`, unique: true, name: "uq_users_email_lower")
  @@map("users")
}

model RefreshToken {
  id           Uuid                              @id @onCreate(uuid())
  userId       Uuid                              @map("user_id")
  familyId     Uuid                              @map("family_id")
  tokenHash    String(storage: char, length: 64) @unique @map("token_hash")
  expiresAt    DateTime                          @map("expires_at")
  revokedAt    DateTime?                         @map("revoked_at")
  replacedById Uuid?                             @map("replaced_by_id")
  userAgent    String?                           @map("user_agent")
  ipAddress    String?                           @map("ip_address")
  createdAt    DateTime                          @default(now()) @map("created_at")
  user         User                              @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Employee {
  id         Uuid                                   @id @onCreate(uuid())
  employeeNo String(storage: varchar, length: 50)   @map("employee_no")
  firstName  String(storage: varchar, length: 100)  @map("first_name")
  middleName String(storage: varchar, length: 100)? @map("middle_name")
  lastName   String(storage: varchar, length: 100)  @map("last_name")
  dateHired  Date                                   @map("date_hired")
  createdAt  DateTime                               @default(now()) @map("created_at")
  updatedAt  DateTime                               @onCreate(now()) @onUpdate(now()) @map("updated_at")

  @@index(expression: sql`lower(employee_no)`, unique: true, name: "uq_employees_employee_no_lower")
  @@map("employees")
}

model SalaryAssignment {
  id                 Uuid                             @id @onCreate(uuid())
  employeeId         Uuid                             @map("employee_id")
  monthlyBasicSalary Decimal(precision: 12, scale: 2) @map("monthly_basic_salary")
  deletedAt          DateTime?                        @map("deleted_at")
  createdAt          DateTime                         @default(now()) @map("created_at")
  updatedAt          DateTime                         @onCreate(now()) @onUpdate(now()) @map("updated_at")
  employee           Employee                         @relation(fields: [employeeId], references: [id])

  @@index([employeeId], unique: true, where: sql`deleted_at IS NULL`, name: "uq_active_salary_per_employee")
  @@index([employeeId])
  @@check(expression: sql`monthly_basic_salary > 0`, name: "chk_salary_assignments_basic_positive")
  @@map("salary_assignments")
}

model SalaryComponent {
  id        Uuid                                  @id @onCreate(uuid())
  name      String(storage: varchar, length: 100)
  deletedAt DateTime?                             @map("deleted_at")
  createdAt DateTime                              @default(now()) @map("created_at")
  updatedAt DateTime                              @onCreate(now()) @onUpdate(now()) @map("updated_at")

  @@index(expression: sql`lower(trim(name))`, unique: true, where: sql`deleted_at IS NULL`, name: "uq_active_component_name")
  @@map("salary_components")
}

model EmployeeSalaryComponent {
  id                Uuid                             @id @onCreate(uuid())
  employeeId        Uuid                             @map("employee_id")
  salaryComponentId Uuid                             @map("salary_component_id")
  amount            Decimal(precision: 12, scale: 2)
  deletedAt         DateTime?                        @map("deleted_at")
  createdAt         DateTime                         @default(now()) @map("created_at")
  updatedAt         DateTime                         @onCreate(now()) @onUpdate(now()) @map("updated_at")
  employee          Employee                         @relation(fields: [employeeId], references: [id])
  salaryComponent   SalaryComponent                  @relation(fields: [salaryComponentId], references: [id])

  @@index([employeeId, salaryComponentId], unique: true, where: sql`deleted_at IS NULL`, name: "uq_active_component_per_employee")
  @@index([employeeId])
  @@index([salaryComponentId])
  @@check(expression: sql`amount >= 0`, name: "chk_employee_salary_components_amount_nonneg")
  @@map("employee_salary_components")
}
