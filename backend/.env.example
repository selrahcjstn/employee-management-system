# Copy this file to `.env` and replace the placeholders.
# Connection string for PostgreSQL. Requires PostgreSQL >= 15.
DATABASE_URL="postgresql://user:password@localhost:5432/salary_management_system_db"

# Only for `npm run test:e2e`. Defaults to DATABASE_URL with `_test` added to the database name.
# The tests create and migrate this database themselves and never touch DATABASE_URL's database.
# TEST_DATABASE_URL="postgresql://user:password@localhost:5432/salary_management_system_db_test"

PORT=3000
FRONTEND_ORIGIN="http://localhost:5173"

# Two different secrets, at least 32 characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me-too"
# Lifetimes: a number plus ms, s, m, h, d or w.
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# Behind a reverse proxy, set the number of proxies (or "loopback") so rate limiting uses each
# client's own IP. Leave unset when the API is reached directly.
# TRUST_PROXY=1

# API docs at /api/docs. On by default outside production; set to "true" or "false" to override.
# SWAGGER_ENABLED=false

# Used only by `npm run seed`. The password is hashed before it is stored.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me"
SEED_ADMIN_NAME="Administrator"
