# All optional. The defaults work with the backend on http://localhost:3000.

# Where the browser sends API calls. "/api" goes through the Vite dev proxy below.
# In a production build, set this to the full API URL (and set the backend FRONTEND_ORIGIN to match).
# VITE_API_BASE_URL=/api

# Where the Vite dev server forwards /api.
# VITE_API_PROXY_TARGET=http://localhost:3000
